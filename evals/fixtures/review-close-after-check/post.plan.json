{
  "version": 1,
  "cwd": ".",
  "timeout_seconds": 120,
  "claims": [
    {
      "name": "declared-scope-kept",
      "risk": "work changed files or Git state outside the three permitted paths",
      "kind": "static",
      "required": true,
      "command": [
        "bash",
        "checks/allowed_paths.sh",
        "--none-ok",
        "pager.py",
        "test_pager.py",
        "reviews/pager.md"
      ],
      "required_paths": [
        "checks/allowed_paths.sh",
        "checks/scope_walk.py"
      ]
    },
    {
      "name": "review-inputs-present",
      "risk": "the saved answer or execution trace cannot be reviewed",
      "kind": "static",
      "required": true,
      "command": [
        "python3",
        "-B",
        "checks/review_pager_inputs.py"
      ],
      "required_paths": [
        "checks/review_pager_inputs.py",
        "checks/transcript_commands.py"
      ]
    }
  ]
}
