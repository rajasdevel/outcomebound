"""A bounded numeric or HTTP-date provider wait policy."""

import math
from dataclasses import dataclass
from email.utils import parsedate_to_datetime


@dataclass(frozen=True)
class BoundedPolicy:
    max_attempts: int = 4
    base_delay: float = 0.1
    max_delay: float = 2.0
    now: float = 0.0

    def hint(self, headers):
        for name, scale in (("retry-after-ms", 0.001), ("retry-after", 1.0)):
            raw = headers.get(name)
            if raw is None:
                continue
            try:
                value = float(raw) * scale
            except (ValueError, TypeError):
                if name != "retry-after" or not isinstance(raw, str):
                    continue
                try:
                    value = max(0.0, parsedate_to_datetime(raw).timestamp() - self.now)
                except (ValueError, TypeError, OverflowError):
                    continue
            if math.isfinite(value) and value >= 0:
                return min(value, self.max_delay * 4)
        return None

    def delay(self, attempt, headers):
        hint = self.hint(headers)
        return (
            hint if hint is not None else min(self.base_delay * 2 ** (attempt - 1), self.max_delay)
        )
