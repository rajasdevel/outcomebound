{
  "version": 1,
  "cwd": ".",
  "timeout_seconds": 300,
  "claims": [
    {
      "name": "stale-removed",
      "risk": "a stale worktree, merged branch or scratch file is left",
      "kind": "static",
      "required": true,
      "command": [
        "sh",
        "-c",
        "exec python3 -B \"${OUTCOMEBOUND_GRADER_DIR:?the runner sets OUTCOMEBOUND_GRADER_DIR}/checks/corelib.py\" stale-removed"
      ]
    },
    {
      "name": "kept-intact",
      "risk": "uncommitted work, an unmerged branch or kept reports were lost",
      "kind": "static",
      "required": true,
      "command": [
        "sh",
        "-c",
        "exec python3 -B \"${OUTCOMEBOUND_GRADER_DIR:?the runner sets OUTCOMEBOUND_GRADER_DIR}/checks/corelib.py\" kept-intact"
      ]
    },
    {
      "name": "kept-said",
      "risk": "the answer does not say what was kept and why",
      "kind": "static",
      "required": false,
      "command": [
        "sh",
        "-c",
        "exec python3 -B \"${OUTCOMEBOUND_GRADER_DIR:?the runner sets OUTCOMEBOUND_GRADER_DIR}/checks/corelib.py\" kept-said"
      ]
    },
    {
      "name": "observed-cleanup",
      "risk": "how the run removed things, for the record",
      "kind": "static",
      "required": false,
      "command": [
        "sh",
        "-c",
        "exec python3 -B \"${OUTCOMEBOUND_GRADER_DIR:?the runner sets OUTCOMEBOUND_GRADER_DIR}/checks/corelib.py\" observed-cleanup"
      ]
    }
  ]
}
