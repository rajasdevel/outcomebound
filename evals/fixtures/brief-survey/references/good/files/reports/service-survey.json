{
  "chat_path": "/v1/chat",
  "default_model": "chat-large-3",
  "small_alias": "chat-small-3",
  "chat_rate_per_second": 10,
  "chat_capacity": 21,
  "chat_max_body_bytes": 65536,
  "embed_batch": 16,
  "retryable_statuses": [
    429,
    500,
    502,
    503,
    504
  ],
  "attempts": 3,
  "delay_ms_hint_seconds": 1.5,
  "delay_fallback_seconds": 0.4,
  "provider_429_caller_status": 503,
  "provider_404_caller_status": 502,
  "live_quota_verified": false,
  "sources": [
    "config/chatsvc.ini",
    "config/limits.conf",
    "chatsvc/config.py",
    "chatsvc/retry.py",
    "chatsvc/routes.py",
    "chatsvc/limits.py"
  ]
}