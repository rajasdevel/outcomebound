import unittest

from chatsvc.provider import Response
from chatsvc.retry import RetryPolicy, call_with_retry


class Scripted:
    def __init__(self, *responses):
        self.responses = list(responses)
        self.calls = 0

    def __call__(self):
        self.calls += 1
        return self.responses.pop(0)


class RetryTest(unittest.TestCase):
    def test_success_is_not_retried(self):
        send = Scripted(Response(200))
        response, attempts = call_with_retry(send, RetryPolicy(), sleep=lambda s: None)
        self.assertEqual((response.status, attempts), (200, 1))

    def test_a_client_error_is_not_retried(self):
        send = Scripted(Response(404))
        _, attempts = call_with_retry(send, RetryPolicy(), sleep=lambda s: None)
        self.assertEqual(attempts, 1)

    def test_429_is_retried_after_the_hinted_wait(self):
        waits = []
        send = Scripted(Response(429, {"retry-after-ms": "250"}), Response(200))
        response, attempts = call_with_retry(send, RetryPolicy(), sleep=waits.append)
        self.assertEqual((response.status, attempts), (200, 2))
        self.assertEqual(waits, [0.25])

    def test_retry_after_in_seconds(self):
        self.assertEqual(RetryPolicy().delay(1, {"retry-after": "2"}), 2.0)

    def test_without_a_hint_the_wait_doubles_up_to_the_cap(self):
        policy = RetryPolicy(base_delay=0.1, max_delay=0.3)
        self.assertEqual([policy.delay(n, {}) for n in (1, 2, 3)], [0.1, 0.2, 0.3])

    def test_attempts_stop_at_the_maximum(self):
        send = Scripted(*[Response(503)] * 5)
        response, attempts = call_with_retry(
            send, RetryPolicy(max_attempts=3), sleep=lambda s: None
        )
        self.assertEqual((response.status, attempts, send.calls), (503, 3, 3))


if __name__ == "__main__":
    unittest.main()
