{
  "version": 1,
  "cwd": ".",
  "timeout_seconds": 120,
  "claims": [
    {
      "name": "docstring-fixed-behaviour-unchanged",
      "risk": "the docstring still says the bounds are excluded, or the finding was settled by changing the code",
      "kind": "runtime",
      "required": true,
      "command": [
        "python3",
        "-B",
        "checks/probe_clamp.py",
        "fixed"
      ],
      "required_paths": [
        "checks/probe_clamp.py",
        "clamp.py"
      ]
    },
    {
      "name": "only-the-fix-and-the-review-changed",
      "risk": "a right and small finding grew files, edits elsewhere or a commit",
      "kind": "static",
      "required": true,
      "command": [
        "bash",
        "checks/allowed_paths.sh",
        "clamp.py",
        "test_clamp.py",
        "reviews/clamp.md"
      ],
      "required_paths": [
        "checks/allowed_paths.sh",
        "checks/scope_walk.py"
      ]
    },
    {
      "name": "finding-ends-fixed",
      "risk": "the finding has no disposition in the review file's format",
      "kind": "static",
      "required": true,
      "command": [
        "python3",
        "-B",
        "checks/probe_clamp.py",
        "disposition"
      ],
      "required_paths": [
        "checks/probe_clamp.py",
        "reviews/clamp.md"
      ]
    },
    {
      "name": "nothing-installed",
      "risk": "a one-line fix ran an installer",
      "kind": "static",
      "required": true,
      "command": [
        "python3",
        "-B",
        "checks/probe_clamp.py",
        "plain"
      ],
      "required_paths": [
        "checks/probe_clamp.py",
        "checks/transcript_commands.py"
      ]
    }
  ]
}
