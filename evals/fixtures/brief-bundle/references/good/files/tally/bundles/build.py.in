"""Build and validate portable time-entry bundles."""

import hashlib
import json
import shutil
import tempfile
from datetime import date
from pathlib import Path

from tally import aggregate, merge, readers
from tally.errors import TallyError


def summary(entries, by, duplicates):
    groups = aggregate.group(entries, by)
    return {"entry_count": len(entries), "duplicate_count": duplicates,
            "total_minutes": sum(e.minutes for e in entries), "by": by,
            "rows": [{"key": g.key, "entry_count": g.entry_count, "total_minutes": g.minutes}
                     for g in groups]}


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def build(files, out, by="project", since=None, until=None):
    out = Path(out)
    if out.exists() or out.is_symlink():
        raise TallyError("E104", "output exists")
    try:
        low = date.fromisoformat(since) if since else None
        high = date.fromisoformat(until) if until else None
    except ValueError:
        raise TallyError("E104", "invalid bound") from None
    if low and high and low > high:
        raise TallyError("E104", "reversed window")
    entries, duplicates = merge.merge([readers.read(path) for path in files])
    entries = [e for e in entries if (low is None or e.day >= low) and (high is None or e.day <= high)]
    result = summary(entries, by, duplicates)
    temp = Path(tempfile.mkdtemp(prefix=".bundle-", dir=out.parent))
    try:
        readers.write_csv(entries, temp / "entries.csv")
        (temp / "summary.json").write_text(json.dumps(result, sort_keys=True) + "\n", encoding="utf-8")
        manifest = {"schema": 1, "files": {name: digest(temp / name) for name in ("entries.csv", "summary.json")}}
        (temp / "manifest.json").write_text(json.dumps(manifest, sort_keys=True) + "\n", encoding="utf-8")
        verify(temp)
        temp.rename(out)
    finally:
        if temp.exists():
            shutil.rmtree(temp)
    return result


def verify(folder):
    folder = Path(folder)
    expected = {"entries.csv", "summary.json", "manifest.json"}
    if folder.is_symlink() or not folder.is_dir() or {p.name for p in folder.iterdir()} != expected:
        raise TallyError("E102", "bundle file set")
    if any(p.is_symlink() or not p.is_file() for p in folder.iterdir()):
        raise TallyError("E102", "bundle file type")
    manifest = json.loads((folder / "manifest.json").read_text(encoding="utf-8"))
    digests = {name: digest(folder / name) for name in ("entries.csv", "summary.json")}
    if manifest != {"schema": 1, "files": digests}:
        raise TallyError("E102", "bundle digest")
    actual = json.loads((folder / "summary.json").read_text(encoding="utf-8"))
    entries = readers.read(folder / "entries.csv")
    if entries != sorted(set(entries)):
        raise TallyError("E102", "bundle entries not canonical")
    count = actual.get("duplicate_count")
    if type(count) is not int or count < 0 or actual != summary(entries, actual.get("by"), count):
        raise TallyError("E102", "bundle summary")
    return actual


def compare(old, new):
    before, after = verify(old), verify(new)
    if before["by"] != after["by"]:
        raise TallyError("E104", "groupings differ")
    left = {r["key"]: r["total_minutes"] for r in before["rows"]}
    right = {r["key"]: r["total_minutes"] for r in after["rows"]}
    rows = [{"key": key, "before_minutes": left.get(key, 0), "after_minutes": right.get(key, 0),
             "delta_minutes": right.get(key, 0) - left.get(key, 0)}
            for key in sorted(left.keys() | right.keys()) if left.get(key, 0) != right.get(key, 0)]
    return {"by": before["by"], "rows": rows}
