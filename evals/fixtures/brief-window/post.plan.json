{
  "version": 1,
  "cwd": ".",
  "timeout_seconds": 90,
  "claims": [
    {
      "name": "owned-bounds",
      "risk": "an unowned file, Git ref or forbidden command changed the task scope",
      "kind": "static",
      "required": true,
      "command": [
        "sh",
        "-c",
        "exec python3 -I -B \"${OUTCOMEBOUND_GRADER_DIR:?}/checks/brief.py\" owned-bounds"
