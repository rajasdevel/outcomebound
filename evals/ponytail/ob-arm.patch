+# --- OutcomeBound adapter (ob-arm.patch; OutcomeBound's evals/ponytail/driver.py applies it) ---
+PINNED_PLUGINS = {}  # arm -> plugin dir given with --pinned-plugin ARM=PATH; the user's plugin cache is refused
+OB_LAUNCHER = None   # OutcomeBound's launcher (--ob-launcher); the ob arm's cell is installed with its adopt
+OB_CHECKS = None     # OutcomeBound's checks module (--ob-checks): completion oracles and the loading check
+DRY_RUN = False      # --dry-run: build every cell and record its command and environment; start no claude
+CELL_ENV_KEEP = ("PATH", "LANG", "LC_ALL", "LC_CTYPE", "TERM", "USER", "LOGNAME", "SHELL")
+CELL_AUTH_KEEP = ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN")  # recorded as <set>
+
+def _pinned_plugin_dir(name):
+    """The plugin dir pinned for this arm, never the env override or the user's cache."""
+    p = PINNED_PLUGINS.get(name)
+    if not p:
+        sys.exit(f"{name}: no pinned plugin dir (--pinned-plugin {name}=PATH); the user's plugin cache is refused")
+    if not (Path(p) / ".claude-plugin" / "plugin.json").is_file():
+        sys.exit(f"{name}: {p} holds no .claude-plugin/plugin.json")
+    return str(Path(p).resolve())
+
+def _cell_env(cell: Path):
+    """Fresh state per cell: a new HOME, XDG folders, Claude config dir and TMPDIR under the cell.
+    Only CELL_ENV_KEEP and CELL_AUTH_KEEP are inherited, so every PONYTAIL_* variable and the
+    user's other settings are left out. Instruction files are not disabled for any arm."""
+    home = cell / "home"
+    env = {k: os.environ[k] for k in CELL_ENV_KEEP + CELL_AUTH_KEEP if k in os.environ}
+    env.update(HOME=str(home), XDG_CONFIG_HOME=str(home / ".config"), XDG_DATA_HOME=str(home / ".local" / "share"),
+               XDG_CACHE_HOME=str(home / ".cache"), XDG_STATE_HOME=str(home / ".local" / "state"),
+               CLAUDE_CONFIG_DIR=str(cell / "claude-config"), TMPDIR=str(cell / "tmp"),
+               CLAUDE_CODE_DISABLE_AUTO_MEMORY="1")
+    for k in ("XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "XDG_STATE_HOME", "CLAUDE_CONFIG_DIR", "TMPDIR"):
+        Path(env[k]).mkdir(parents=True, exist_ok=True)
+    return env
+
+def _evidence(workdir: Path):
+    """Raw CLI output and grading baselines live beside the workspace (cell/evidence), not in it."""
+    workdir = Path(workdir)
+    return workdir.parent / "evidence" if workdir.name == "ws" and (workdir.parent / "evidence").is_dir() else None
+
+def _manifest(workdir: Path):
+    ev = _evidence(workdir)
+    return (ev if ev else Path(workdir)) / "_fixture_files.json"
+
+def _base_git(workdir: Path):
+    ev = _evidence(workdir)
+    return ev / "base" / ".git" if ev and (ev / "base" / ".git").is_dir() else None
+
+def _files(workdir: Path):
+    return sorted(str(p.relative_to(workdir)).replace("\\", "/") for p in workdir.rglob("*")
+                  if p.is_file() and ".git" not in p.relative_to(workdir).parts)
+
+def _ob_install(workdir: Path):
+    """Install OutcomeBound into the cell as an adopter does; returns the files it wrote."""
+    if not OB_LAUNCHER:
+        sys.exit("ob arm: no --ob-launcher; refusing to run the ob arm without OutcomeBound's install")
+    before = {f: (workdir / f).read_bytes() for f in _files(workdir)}
+    env = {**_cell_env(workdir.parent), "OUTCOMEBOUND_HOME": str(Path(OB_LAUNCHER).resolve().parents[1]),
+           "GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_NOSYSTEM": "1"}
+    done = subprocess.run([OB_LAUNCHER, "adopt", ".", "--harness", "claude-code"], cwd=str(workdir), env=env,
+                          capture_output=True, text=True, timeout=300)
+    (workdir.parent / "evidence" / "adopt.txt").write_text(done.stdout + done.stderr, encoding="utf-8")
+    if done.returncode != 0:
+        sys.exit(f"ob arm: adopt exited {done.returncode}: {(done.stdout + done.stderr)[-400:]}")
+    return [f for f in _files(workdir) if before.get(f) != (workdir / f).read_bytes()]
+
+def _build_cell(task_id, arm, workdir: Path):
+    """Every arm's cell is built the same way, in this order: git init, seed, the ob arm's install,
+    the manifest, the snapshot. The manifest and a clone of the snapshot go to cell/evidence."""
+    task = TASKS[task_id]
+    ev = workdir.parent / "evidence"
+    ev.mkdir(parents=True, exist_ok=True)
+    _git(workdir, "init", "-q")
+    seeded = []
+    if task.get("fixture"):                            # copy a real repo in; record what was seeded
+        fx = Path(task["fixture"])                     # absolute path, or a name under fixtures/
+        if not fx.is_absolute(): fx = Path(__file__).resolve().parent / "fixtures" / task["fixture"]
+        shutil.copytree(fx, workdir, dirs_exist_ok=True,
+                        ignore=shutil.ignore_patterns("node_modules", ".git", "build", "dist",
+                                                       "dist-ssr", ".vite", "*.log", "__pycache__",
+                                                       "storage", ".venv", "venv", ".pytest_cache",
+                                                       "*.mp4", "*.mp3", "*.wav", "*.mov",
+                                                       "*service-account*.json",
+                                                       "nul", "con", "prn", "aux",
+                                                       "DatePicker*.tsx", "DatePicker*.jsx"))
+        seeded = _files(workdir)
+    for fn, content in task.get("seed", {}).items():
+        _write(workdir / fn, content)
+    installed = _ob_install(workdir) if arm == "ob" else []
+    manifest = sorted(set(seeded) | set(installed))   # a seed task's own files stay counted, as upstream
+    (ev / "_fixture_files.json").write_text(json.dumps(manifest), encoding="utf-8")
+    (ev / "installed.json").write_text(json.dumps(installed), encoding="utf-8")
+    _git_snapshot(workdir)
+    _git(workdir.parent, "clone", "-q", "--no-checkout", str(workdir), str(ev / "base"))
+    return _baseline_digest(workdir)
+
+def _baseline_digest(workdir: Path):
+    m = _manifest(workdir)
+    head = _git(workdir, "rev-parse", "HEAD", git_dir=_base_git(workdir)).stdout.strip()
+    return {"manifest": hashlib.sha256(m.read_bytes()).hexdigest() if m.exists() else None, "base": head}
+
+def _claude_events(workdir: Path):
+    """The CLI's stream-JSON events (cell/evidence/_claude.jsonl); upstream's _claude.json as one event."""
+    ev = _evidence(workdir)
+    stream = ev / "_claude.jsonl" if ev else None
+    if stream and stream.exists():
+        out = []
+        for line in stream.read_text(encoding="utf-8", errors="replace").splitlines():
+            try: out.append(json.loads(line))
+            except ValueError: pass
+        return out
+    cj = (ev if ev else Path(workdir)) / "_claude.json"
+    try: return [json.loads(cj.read_text(encoding="utf-8"))] if cj.exists() else []
+    except ValueError: return []
+
+def _load_ob_checks(path):
+    spec = importlib.util.spec_from_file_location("ob_checks", path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
