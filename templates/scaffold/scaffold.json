      "id": "branch-rule",
      "text": "a rule on the main branch: changes by pull request only, no force push, no deletion, the CI check required",
      "who": "a repository admin",
      "for": [
        "solo",
        "team",
        "organization"
      ],
      "status": {
        "public": "listed",
        "private": "listed",
        "private-free": "not enforced: a private repository on this plan holds no branch rule and no required review; CI still runs, after the change has landed",
        "other-host": "UNVERIFIED: the research read one host's plans only"
      }
    },
    {
      "id": "required-review",
