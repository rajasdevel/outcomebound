{
  "version": 1,
  "lifecycles": [
    {
      "id": "prototype",
      "kind": "preset",
      "assumes": [
        "life: to learn, then discard or keep what the signal justifies",
        "maintainers: one, or the few who build it",
        "dependants: none, or invited testers with no real data"
      ],
      "fragments": [
        "local",
        "explore",
        "solo",
        "commands"
      ],
      "edges": []
    },
    {
      "id": "solo",
      "kind": "preset",
      "assumes": [
        "life: a product",
        "maintainers: one",
        "dependants: any number"
      ],
      "fragments": [
        "local",
        "solo",
        "commands"
      ],
      "edges": []
    },
    {
      "id": "team",
      "kind": "preset",
      "assumes": [
        "life: a product",
        "maintainers: two or more in one team",
        "dependants: outside users or adopters"
      ],
      "fragments": [
        "local",
        "team",
        "commands"
      ],
      "edges": []
    },
    {
      "id": "organization",
      "kind": "preset",
      "assumes": [
        "life: a product",
        "maintainers: several teams, or owners by area",
        "dependants: many, or other teams"
      ],
      "fragments": [
        "local",
        "team",
        "commands"
      ],
      "edges": []
    },
    {
      "id": "client",
      "kind": "overlay",
      "assumes": [
        "who accepts: an outside party on a named build"
      ],
      "fragments": [
        "client"
      ],
      "edges": [],
      "refused_on": [
        "prototype"
      ],
      "refusal": "a prototype ends at its first outside user or real personal data; move it to solo or team first"
    },
    {
      "id": "eu-market",
      "kind": "overlay",
      "assumes": [
        "market: placed on the EU market in a commercial activity"
      ],
      "fragments": [],
      "edges": [
        "rewriting published history"
      ],
      "refused_on": [
        "prototype"
      ],
      "refusal": "a prototype ends at its first outside user or real personal data; move it to solo or team first"
    },
    {
      "id": "safety-critical",
      "kind": "overlay",
      "assumes": [
        "harm: a failure can harm a person, and a safety lifecycle standard applies"
      ],
      "fragments": [],
      "edges": []
    },
    {
      "id": "audit",
      "kind": "overlay",
      "assumes": [
        "audit: an auditor examines the controls"
      ],
      "fragments": [],
      "edges": [],
      "refused_on": [
        "prototype"
      ],
      "refusal": "a prototype ends at its first outside user or real personal data; move it to solo or team first"
    },
    {
      "id": "unattended-agents",
      "kind": "overlay",
      "assumes": [
        "agents: some run without a person watching"
      ],
      "fragments": [],
      "edges": []
    },
    {
      "id": "ai-product",
      "kind": "overlay",
      "assumes": [
        "product: it calls a model"
      ],
      "fragments": [],
      "edges": []
    }
  ],
  "acts": [
    {
      "id": "deploy",
      "fragments": [
        "deploy",
        "runtime"
      ],
      "edges": [
        "a deploy to production"
      ]
    },
    {
      "id": "publish",
      "fragments": [
        "ci-release"
      ],
      "edges": []
    },
    {
      "id": "tag",
      "fragments": [],
      "edges": [
        "pushing a tag"
      ]
    },
    {
      "id": "stored-data",
      "fragments": [
        "db-migrations"
      ],
      "edges": [
        "a change to stored production data"
      ]
    }
  ],
