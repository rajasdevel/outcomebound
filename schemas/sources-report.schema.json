{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:outcomebound:schema:sources-report:1",
  "title": "OutcomeBound sources check report v1",
  "description": "What `outcomebound sources check --json` prints. Each finding says what it does not establish.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "verdict", "counts", "findings"],
  "properties": {
    "version": {"const": 1},
    "verdict": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "FAIL", "UNVERIFIED", "INFO"],
      "properties": {
        "PASS": {"type": "integer"},
        "FAIL": {"type": "integer"},
        "UNVERIFIED": {"type": "integer"},
        "INFO": {"type": "integer"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "verdict", "subject", "text", "does_not_establish"],
        "properties": {
          "code": {"type": "string"},
          "verdict": {"enum": ["PASS", "FAIL", "UNVERIFIED", "INFO"]},
          "subject": {"type": "string"},
          "text": {"type": "string"},
          "does_not_establish": {"type": "string"}
        }
      }
    }
  }
}
