{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:outcomebound:schema:review-since:1",
  "title": "OutcomeBound review since report v1",
  "description": "What `outcomebound review since --json` prints: what changed between the ref a review file read and the work tree, and which findings cite a changed path. `result` is REPORT or UNVERIFIED, never a pass or a fail.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "result",
    "does_not_establish"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "result": {
      "enum": [
        "REPORT",
        "UNVERIFIED"
      ]
    },
    "reason": {
      "description": "Only with UNVERIFIED: why nothing was read.",
      "type": "string"
    },
    "reviewed": {
      "description": "The `Reviewed:` ref as the file writes it.",
      "type": "string"
    },
    "commit": {
      "description": "The commit Git resolved the ref to.",
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "status",
          "added",
          "removed",
          "hunks"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "old_path": {
            "description": "Only for a rename or a copy.",
            "type": "string"
          },
          "status": {
            "enum": [
              "modified",
              "added",
              "deleted",
              "renamed",
              "type-changed",
              "untracked"
            ]
          },
          "added": {
            "description": "Null for a binary file and for an untracked one.",
            "type": [
              "integer",
              "null"
            ]
          },
          "removed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "hunks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "old_start",
                "old_count",
                "new_start",
                "new_count"
              ],
              "properties": {
                "old_start": {
                  "type": "integer"
                },
                "old_count": {
                  "type": "integer"
                },
                "new_start": {
                  "type": "integer"
                },
                "new_count": {
                  "type": "integer"
                }
              }
            },
            "description": "Changed spans, read with no context lines; a count of 0 is a span with no line."
          }
        }
      }
    },
    "findings": {
      "description": "Each finding of the review file that cites a changed path.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "line",
          "cites"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "line": {
            "description": "The line of the finding's heading in the review file.",
            "type": "integer"
          },
          "cites": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "line_changed"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "description": "Absent when the finding names the path with no line.",
                  "type": "integer"
                },
                "line_end": {
                  "type": "integer"
                },
                "line_changed": {
                  "description": "True when the cited line lies in a span the reviewed file lost (a hunk's old side).",
                  "type": "boolean"
                },
                "candidates": {
                  "description": "Only when the reference is a suffix of several changed paths.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "does_not_establish": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ref_source": {
      "enum": [
        "Reviewed line",
        "--since"
      ]
    },
    "ref_is_moving": {
      "description": "True when the ref is a branch or HEAD, whose tip now may not be what the review read.",
      "type": "boolean"
    },
    "untracked_skipped": {
      "description": "Untracked entries that are not regular files.",
      "type": "integer"
    }
  }
}
