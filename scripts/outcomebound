#!/bin/sh
# A checkout's launcher: `outcomebound <verb> ...` runs the engine of the checkout it sits in.
#
# It is for contributors and for this repository's own scripts and CI. An installed package has
# its own command instead, the console entry point outcomebound_tools/launcher.py makes, which
# pip and uv turn into an `outcomebound` program on every platform, Windows included.
#
# This one resolves its own path through any symlink, so a link on PATH runs the engine it points
# into, whichever directory the caller is standing in. It sits in scripts/, beside
# outcomebound_tools/, and runs that checkout with a Python 3.10 or later from PATH. Python runs
# isolated (-I) and in UTF-8 mode (-X utf8): its path holds the engine and the standard library
# only, so neither the caller's directory nor PYTHONPATH can shadow the engine, and nothing is
# exported, so a command the engine runs, such as a project's own `python -m pytest`, gets the
# caller's environment unchanged. The verbs are outcomebound_tools/__main__.py's. A failure of
# this launcher exits 127, never 2: a harness's stop hook reads exit 2 as holding the turn.
set -eu

# The first python3 or python that an absolute PATH entry names and that runs as Python 3.10 or
# later, so a relative entry such as `.` never picks it, and neither does a stub that opens a
# store or a Python 2. PATH is split by hand, since zsh does not word-split an unquoted $PATH.
python_on_path() {
	rest=$PATH:
	while [ -n "$rest" ]; do
		dir=${rest%%:*}
		rest=${rest#*:}
		case $dir in
		/*) for name in python3 python; do
			if [ -x "$dir/$name" ] &&
				"$dir/$name" -I -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
				printf '%s\n' "$dir/$name"
				return 0
			fi
		done ;;
		esac
	done
	return 1
}

python=$(python_on_path) || {
	printf '%s\n' "outcomebound: no Python 3.10 or later (python3 or python) on an absolute PATH entry" >&2
	exit 127
}
exec "$python" -I -X utf8 -c 'from pathlib import Path
import runpy, sys
try:
    self = Path(sys.argv[1]).resolve(strict=True)
    root = self.parent.parent
    has_engine = (root / "outcomebound_tools").is_dir()
except (OSError, RuntimeError) as error:
    print(f"outcomebound: cannot resolve launcher {sys.argv[1]}: {error}", file=sys.stderr)
    raise SystemExit(127)
if not has_engine:
    print(f"outcomebound: no engine beside {self}; this launcher runs a checkout, and an installed package has its own command", file=sys.stderr)
    raise SystemExit(127)
sys.path.insert(0, str(root))
sys.argv = ["outcomebound", *sys.argv[2:]]
runpy.run_module("outcomebound_tools", run_name="__main__", alter_sys=True)
' "$0" "$@"
